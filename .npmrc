auto-install-peers=true
git-checks=false

# Cross-package deps in this repo are declared as plain semver ranges rather than
# `workspace:*`, so that the published manifests are correct no matter which tool
# does the publishing. (`npm publish` does not understand the `workspace:` protocol
# and will ship the literal string, which makes the package uninstallable.)
# This tells pnpm to keep linking the local packages during development anyway,
# instead of fetching the last released copy from the registry.
link-workspace-packages=true
prefer-workspace-packages=true
